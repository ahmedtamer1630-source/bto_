document.getElementById('mSizes').innerHTML=["S","M","L","XL"].map(z=>`<button data-z="${z}">${z}</button>`).join('');
function setActive(i){cur=Math.max(0,Math.min(P.imgs.length-1,i));
  mThumbs.querySelectorAll('button').forEach((b,j)=>b.classList.toggle('on',j===cur));
  document.getElementById('mCount').textContent=LABELS[cur]+' · '+(cur+1)+'/'+P.imgs.length}
function go(i){i=(i+P.imgs.length)%P.imgs.length;mTrack.scrollTo({left:i*mTrack.clientWidth,behavior:'smooth'});setActive(i)}
mTrack.addEventListener('scroll',()=>{if(mTrack.clientWidth)setActive(Math.round(mTrack.scrollLeft/mTrack.clientWidth))});
mThumbs.onclick=e=>{const b=e.target.closest('button');if(b)go(+b.dataset.i)};
document.getElementById('mPrev').onclick=()=>go(cur-1);
document.getElementById('mNext').onclick=()=>go(cur+1);
document.getElementById('mSizes').onclick=e=>{const b=e.target.closest('button');if(!b)return;size=b.dataset.z;
  document.querySelectorAll('#mSizes button').forEach(x=>x.classList.toggle('on',x===b))};
function openModal(){modal.classList.add('open');modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';mTrack.scrollLeft=0;setActive(0)}
function closeModal(){modal.classList.remove('open');modal.setAttribute('aria-hidden','true');document.body.style.overflow=''}
document.getElementById('mClose').onclick=document.getElementById('mBack').onclick=closeModal;
document.addEventListener('keydown',e=>{if(!modal.classList.contains('open'))return;
  if(e.key==='Escape')closeModal();if(e.key==='ArrowRight')go(cur+1);if(e.key==='ArrowLeft')go(cur-1)});
document.getElementById('mAdd').onclick=()=>{
  if(!size){toast('SELECT A SIZE');return}
  cart.push({...P,name:P.name+' — '+size});renderCart();toast('ADDED TO CART');
  closeModal();drawer.classList.add('open');overlay.classList.add('open')};
/* WhatsApp checkout */
const WA='201033965383';
document.getElementById('ckForm').addEventListener('submit',e=>{
  e.preventDefault();
  if(!cart.length){toast('YOUR CART IS EMPTY');return}
  const f=new FormData(e.target);
  const lines=cart.map((c,i)=>(i+1)+'. '+c.name+' — '+fmt(c.price)).join('\n');
  const total=fmt(cart.reduce((s,c)=>s+c.price,0));
  const msg='New order — BTO\n\n'+lines+'\n\nSubtotal: '+total+'\n\nName: '+f.get('name')+'\nPhone: '+f.get('phone')+'\nGovernorate: '+f.get('gov')+'\nAddress: '+f.get('addr')+(f.get('notes')?'\nNotes: '+f.get('notes'):'')+'\n\nPayment: Cash on delivery';
  const url='https://wa.me/'+WA+'?text='+encodeURIComponent(msg);
  const w=window.open(url,'_blank');
  const l=document.getElementById('waLink');
  l.href=url;l.hidden=false;l.style.display='block';
  if(w){l.style.display='none'}
  toast(w?'ORDER READY — SEND IT ON WHATSAPP':'TAP THE LINK TO OPEN WHATSAPP');
});
/* policy modal */
const pol=document.getElementById('pol');
document.addEventListener('click',e=>{
  if(e.target.closest('[data-pol]')){pol.classList.add('open');pol.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';pol.querySelector('.m-sheet').scrollTop=0}
  else if(e.target.closest('#pol [data-close]')){closePol()}
});
function closePol(){pol.classList.remove('open');pol.setAttribute('aria-hidden','true');if(!modal.classList.contains('open'))document.body.style.overflow=''}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&pol.classList.contains('open'))closePol()});
</script>
</body>
